# Gamescope for Hermes isolated sessions.
#
# Builds the checkout this file lives in (branch `hermes` of
# MrOz59/gamescope) and installs it under /usr/lib/hermes-gamescope, beside
# the distribution's gamescope rather than over it: a Steam Deck-style
# session or the desktop keeps the Gamescope it already uses, and Hermes
# looks in this prefix first. build.sh holds the build every package shares.
#
#   git clone --recursive --branch hermes https://github.com/MrOz59/gamescope.git
#   cd gamescope/packaging/hermes && makepkg -si

pkgname=gamescope-hermes
pkgver=3.17.0
pkgrel=1
pkgdesc="Gamescope build for Hermes isolated sessions (scanout on another device, input from the session seat)"
arch=('x86_64')
url="https://github.com/MrOz59/gamescope"
license=('BSD-2-Clause')
options=('!debug')
depends=(
  'gcc-libs' 'glibc' 'glm' 'hwdata' 'libavif' 'libcap' 'libdecor' 'libdrm'
  'libei' 'libinput' 'libpipewire' 'libx11' 'libxcb' 'libxcomposite'
  'libxcursor' 'libxdamage' 'libxext' 'libxfixes' 'libxi' 'libxkbcommon'
  'libxmu' 'libxrender' 'libxres' 'libxtst' 'libxxf86vm' 'luajit' 'pixman'
  'sdl2' 'seatd' 'vulkan-icd-loader' 'wayland' 'xcb-util-errors'
  'xcb-util-wm' 'xorg-xwayland'
)
makedepends=('cmake' 'git' 'glslang' 'meson' 'ninja' 'vulkan-headers' 'wayland-protocols')

_srcroot() {
  realpath "${startdir}/../.."
}

pkgver() {
  "${startdir}/version.sh"
}

prepare() {
  cd "$(_srcroot)"
  git submodule update --init --recursive \
    subprojects/wlroots subprojects/libliftoff subprojects/vkroots \
    subprojects/libdisplay-info src/reshade thirdparty/SPIRV-Headers
}

build() {
  "${startdir}/build.sh" compile "${srcdir}/build"
}

package() {
  "${startdir}/build.sh" install "${srcdir}/build" "${pkgdir}"
}
