# Gamescope for Hermes isolated sessions.
#
# Builds the checkout this file lives in (branch `hermes` of
# MrOz59/gamescope) and installs it under /usr/lib/hermes-gamescope, beside
# the distribution's gamescope rather than over it: a Steam Deck-style
# session or the desktop keeps the Gamescope it already uses, and Hermes
# looks in this prefix first. build.sh holds the build every package shares.
#
#   git clone --recursive --branch hermes https://github.com/MrOz59/gamescope.git
#   cd gamescope/packaging/hermes && makepkg -si

pkgname=gamescope-hermes
pkgver=3.17.0
pkgrel=1
pkgdesc="Gamescope build for Hermes isolated sessions (scanout on another device, input from the session seat)"
arch=('x86_64')
url="https://github.com/MrOz59/gamescope"
license=('BSD-2-Clause')
options=('!debug')
# Libraries are named by soname where their package provides it (makepkg pins
# the version): pacman then refuses an update that would break the binaries.
# gamescope-hermes.hook reports the rest after each update.
depends=(
  'gcc-libs' 'glibc' 'hwdata' 'libavif' 'libcap.so' 'libdecor' 'libdrm'
  'libeis.so' 'libinput.so' 'liblcms2.so' 'libpipewire-0.3.so'
  'libpixman-1.so' 'libseat.so' 'libudev.so' 'libwayland-client.so'
  'libwayland-server.so' 'libx11' 'libxcb' 'libxcomposite' 'libxcursor'
  'libxdamage' 'libxext' 'libxfixes' 'libxi' 'libxkbcommon.so' 'libxmu'
  'libxrender' 'libxres' 'libxtst' 'libxxf86vm' 'luajit' 'sdl2'
  'vulkan-icd-loader' 'xkeyboard-config' 'xorg-xwayland'
)
makedepends=('cmake' 'git' 'glm' 'glslang' 'meson' 'ninja' 'vulkan-headers' 'wayland-protocols')

_srcroot() {
  realpath "${startdir}/../.."
}

pkgver() {
  "${startdir}/version.sh"
}

prepare() {
  cd "$(_srcroot)"
  git submodule update --init \
    subprojects/wlroots subprojects/libliftoff subprojects/vkroots \
    subprojects/libdisplay-info src/reshade thirdparty/SPIRV-Headers
}

build() {
  "${startdir}/build.sh" compile "${srcdir}/build"
}

package() {
  "${startdir}/build.sh" install "${srcdir}/build" "${pkgdir}"
  install -Dm644 "${startdir}/gamescope-hermes.hook" -t "${pkgdir}/usr/share/libalpm/hooks/"
  install -Dm755 "${startdir}/check-libs.sh" "${pkgdir}/usr/share/libalpm/scripts/gamescope-hermes-libs"
}
